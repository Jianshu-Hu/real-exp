{
    "name": "AI Server (Cloud GPU)",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": [
        "--gpus", "all",
        "--ipc=host",
        "--network=host",
        "--privileged",
        "-v", "/dev:/dev"
    ],
    // 【新增】挂载一个持久化的 volume 用于保存 uv 的下载缓存
    "mounts": [
        "source=uv-cache,target=/root/.cache/uv,type=volume",
        "source=${localEnv:HOME}/.codex,target=/root/.codex,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff"
            ],
            "settings": {
                // 告诉 VS Code 使用 AI 专属的虚拟环境
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv_ai_server/bin/python",
                // 【新增】解决 Node.js 22 升级导致的 navigator 报错问题
                "extensions.supportNodeGlobalNavigator": true
            }
        }
    },
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "remoteUser": "root",
    // 【核心改进】创建独立命名的虚拟环境 .venv_ai_server
    // "postCreateCommand": "uv venv .venv_ai_server && source .venv_ai_server/bin/activate && cd lerobot && uv pip install -e ."
    // 【修改】去掉了 --clear，改为智能判断：如果不存在则创建，如果存在则直接激活并增量安装
    "postCreateCommand": ["/bin/bash", "-c", "if [ ! -d '.venv_ai_server' ]; then uv venv .venv_ai_server; fi && source .venv_ai_server/bin/activate && cd lerobot && uv pip install -e ."]
}